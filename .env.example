# ===== 运行环境 =====
NODE_ENV=development
PORT=3000
# 允许的跨域来源，逗号分隔（H5 域名/小程序后台域名）。
# 形态逐条校验：仅支持 http(s)://host[:port]、不含路径、禁止通配符 *；
# 生产环境还拒绝空值与 localhost/127.0.0.1（P2-13，启动时 fail-fast）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 信任的反向代理层数：nginx 反代填 1；服务直连公网（无代理）必须填 0，
# 否则 X-Forwarded-For 可被伪造，导致限流/登录失败计数被绕过
TRUST_PROXY_HOPS=1

# ===== MySQL 5.7 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=simple-bookkeeping
DB_CONNECTION_LIMIT=10
# 是否启用 MySQL TLS 加密连接（生产建议开启）
DB_TLS=false
# MySQL TLS 证书校验开关：5.7 自签证书且无法导入 CA 时可改为 false（生产建议 true）
DB_TLS_REJECT_UNAUTHORIZED=true

# ===== Redis 7 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
# 是否启用 Redis TLS 加密连接（生产建议开启）
REDIS_TLS=false

# ===== JWT（生产必须更换，>=32 字节，dev/prod 隔离）=====
JWT_ACCESS_SECRET=change-me-to-a-random-32+-byte-secret
JWT_REFRESH_SECRET=change-me-to-a-random-32+-byte-secret
# access token 默认 30m（P1-01）：配合 token_version 体系（改密/全员登出即时吊销）缩短失陷窗口
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
# refresh token HMAC 胡椒（P2-13，必填，>=32 字节，一密一用，勿与 JWT/FILES_SIGN 密钥重复）：
# 存储的是 HMAC-SHA256(pepper, token)，库泄漏时无 pepper 无法离线还原；生成命令 openssl rand -base64 48
REFRESH_PEPPER=change-me-to-a-random-32+-byte-secret

# ===== Swagger 接口文档（P2-13）=====
# development 默认挂载 /api/docs；production 默认关闭，仅 ENABLE_SWAGGER=true 时挂载，
# 且必须同时配置下方 Basic Auth（密码 >=16 字节），否则启动校验失败
ENABLE_SWAGGER=false
SWAGGER_BASIC_USER=
SWAGGER_BASIC_PASSWORD=

# ===== 文件上传与签名访问 =====
# 图片存储根目录（开发默认 ./uploads，生产 /data/bookkeeping/uploads，须存在且进程可写）
UPLOAD_DIR=./uploads
# 签名 URL 对外基址
FILES_BASE_URL=http://localhost:3000/api/v1/files
# 签名 HMAC 密钥（>=32 字节，独立于 JWT 密钥）
FILES_SIGN_SECRET=change-me-to-a-random-32+-byte-secret
# 签名 URL 有效期（秒，默认 30 分钟；凭证私密资源建议 15~60 分钟）
FILES_LINK_TTL=1800
# 上传限制
UPLOAD_MAX_SIZE_MB=5
UPLOAD_BILL_MAX_EDGE=1440
UPLOAD_AVATAR_MAX_EDGE=512
